# ─────────────────────────────────────────────────────────────
# Cấu hình môi trường – website Kim Ngoan
# Sao chép thành .env.local (dev) hoặc đặt trên máy chủ (production).
# Toàn bộ biến được đọc & kiểm tra tại src/lib/env.ts và src/lib/site.ts
# ─────────────────────────────────────────────────────────────

# Địa chỉ public của website (KHÔNG có dấu / cuối). Dùng cho sitemap, robots,
# canonical, Open Graph, JSON-LD. Production bắt buộc đúng tên miền thật.
NEXT_PUBLIC_SITE_URL=https://kimngoan.com

# Tài khoản quản trị (/admin). Production bắt buộc đặt; mật khẩu ≥ 8 ký tự.
# Dev: bỏ trống sẽ dùng admin@kimngoan.vn / 1
ADMIN_EMAIL=admin@kimngoan.vn
ADMIN_PASSWORD=1

# Khoá ký phiên đăng nhập, ≥ 32 ký tự. Tạo bằng: openssl rand -base64 48
# Đổi khoá = đăng xuất mọi phiên đang mở.
AUTH_SECRET=

# Thư mục lưu dữ liệu admin (settings, sản phẩm, nội dung, ảnh tải lên).
# Đường dẫn tương đối tính từ thư mục dự án. Nhớ sao lưu định kỳ.
# Cần ổ đĩa ghi được – chạy bằng `next start` trên VPS/Docker, không dùng hosting serverless.
DATA_DIR=data
