# ─────────────────────────────────────────────────────────────
# Environment configuration – Kim Ngoan website
# Copy to .env.local (development) or set on the server (production).
# Every variable is read and validated in src/lib/env.ts and src/lib/site.ts.
# ─────────────────────────────────────────────────────────────

# Public site URL (NO trailing slash). Used for the sitemap, robots, canonical
# URLs, Open Graph and JSON-LD. Production must use the real domain.
NEXT_PUBLIC_SITE_URL=https://kimngoan.com

# Admin account (/admin). Required in production; password ≥ 8 characters.
# Development: left empty, admin@kimngoan.vn / 1 is used.
ADMIN_EMAIL=admin@kimngoan.vn
ADMIN_PASSWORD=1

# Session signing key, ≥ 32 characters. Generate with: openssl rand -base64 48
# Rotating the key signs out every open session.
AUTH_SECRET=

# Admin data directory (settings, products, content, uploads).
# Relative paths resolve from the project root. Back it up regularly.
# Needs a writable disk – run with `next start` on a VPS/Docker, not on serverless hosting.
DATA_DIR=data
